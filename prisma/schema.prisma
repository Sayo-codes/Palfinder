generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ============================================================
/// PalfinderProfile — companion profiles shown on /palfinder
/// Managed via the admin panel (PalfinderManagement.tsx) and
/// displayed on the public PalFinder page.
/// ============================================================
model PalfinderProfile {
  id        String   @id @default(cuid())
  name      String
  location  String
  bio       String   @default("")
  price     Float
  rating    Float    @default(5.0)
  /// Age of the companion (must be 18+)
  age       Int
  /// Interest tags e.g. ["Fitness", "Travel"]
  tags      String[]
  /// URL of the main portrait photo (uploaded to Vercel Blob)
  mainPhoto String   @default("")
  /// Array of gallery media URLs (photos + videos)
  gallery   String[]
  /// Mega.nz link for the full pack
  megaLink  String   @default("")
  /// Additional unlock link (optional)
  unlockLink String  @default("")
  /// "active" | "inactive" — only active profiles show on public page
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Profile {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  age          Int
  country      String
  gender       String
  interestedIn String
  bio          String?
  platforms    String[]
  links        Json
  photo        String?
  profileImage String?
  media        String[]
  online       Boolean  @default(false)
  verified     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

/// Stores crypto payment records from NOWPayments gateway.
/// Each record tracks one payment from creation through completion/expiry.
model CryptoPayment {
  id              String    @id @default(cuid())
  paymentId       String    @unique              // NOWPayments payment_id
  orderId         String    @unique              // Our internal order reference (e.g. PAL-xxx)
  profileName     String                         // Name of the profile being purchased
  priceAmount     Float                          // Amount in fiat (USD)
  priceCurrency   String    @default("usd")      // Fiat currency
  payAmount       Float                          // Amount in crypto
  payCurrency     String    @default("usdttrc20")// Crypto currency
  payAddress      String                         // Wallet address for payment
  status          String    @default("waiting")  // waiting, confirming, confirmed, finished, expired, failed
  actuallyPaid    Float     @default(0)          // Amount actually received (in crypto)
  actuallyPaidFiat Float    @default(0)          // Amount actually received (in fiat)
  expiresAt       DateTime?                      // When the payment window expires
  completedAt     DateTime?                      // When payment was confirmed/finished
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([orderId])
}

/// ============================================================
/// DirectPayment — tracks a direct-wallet payment session.
/// Created when the user lands on the pay page. Updated to
/// "confirmed" by the blockchain monitor once a matching
/// transaction is detected on-chain.
/// ============================================================
model DirectPayment {
  id            String    @id @default(cuid())
  /// Unique human-readable reference shown to buyer (PAL-XXXX-YYYY)
  paymentRef    String    @unique
  /// The profile the buyer is trying to unlock
  profileId     String
  profileName   String
  /// Amount in USD the buyer should pay
  priceUsd      Float
  /// Which coin/network was selected ('usdt_trc20' | 'ton')
  coinId        String
  /// The wallet address for this payment
  walletAddress String
  /// waiting | confirmed | expired | failed
  status        String    @default("waiting")
  /// On-chain transaction hash once confirmed
  txHash        String?
  /// Actual crypto amount received
  amountReceived Float?
  /// When the 30-min payment window expires
  expiresAt     DateTime
  /// When the blockchain confirmed the payment
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  access        ProfileAccess?

  @@index([status])
  @@index([profileId])
  @@index([paymentRef])
}

/// ============================================================
/// ProfileAccess — grants a buyer access to locked content.
/// Created automatically when a DirectPayment is confirmed.
/// ============================================================
model ProfileAccess {
  id           String    @id @default(cuid())
  profileId    String
  profileName  String
  paymentRef   String    @unique
  payment      DirectPayment @relation(fields: [paymentRef], references: [paymentRef])
  txHash       String
  buyerContact String?
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@index([profileId])
  @@index([paymentRef])
}
